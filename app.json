{
  "expo": {
    "name": "MediTrack",
    "slug": "meditrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "meditrack",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meditrack.app"
    },
    "android": {
      "package": "com.meditrack.app",
      "adaptiveIcon": {
        "backgroundColor": "#E8F5E9",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2E7D32",
          "sounds": [
            "./assets/sounds/alarm_ringtone.wav"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MediTrack needs camera access to scan your medical bills."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MediTrack needs photo access to scan your medical bills."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d8b609dd-a6ba-4368-8c7c-0fdbb4291ea3"
      }
    }
  }
}
